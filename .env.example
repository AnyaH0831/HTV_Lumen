# Read automatically by the app at startup (server/state.py) -- `make run` needs no sourcing.
# Exporting these first still works and takes precedence over what is in this file.
# Everything is optional. With no keys the agent uses the deterministic offline planner (demo survives no Wi-Fi).
LLM_PROVIDER=offline            # anthropic | gemini | offline (default: anthropic if ANTHROPIC_API_KEY is set, else offline)
NORMALIZER=auto                 # auto | gemini | rule -- stage that turns glosses into one plain-English sentence.
                                # auto = Gemini when it works, deterministic rule pass otherwise (never fatal).
NORMALIZER_TIMEOUT=15           # seconds before the Gemini normalizer gives up and the rule pass takes over
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=                 # one key serves BOTH the normalizer and LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash   # 2.5-flash is 404 for new keys; verified working Oct 2026
# ---- how eagerly the agent speaks what was signed (see docs/AUTONOMY.md) --------------------------
LUMEN_AUTONOMY=fast             # fast (default): speak every non-critical phrase at once; only a CRITICAL word
                                # (EMERGENCY/ALLERGIC/HELP/FALL/POLICE/MEDICINE) that is weak or a close call asks.
                                # tiered: also ask on interpreter doubt and non-critical contradictions (clinic-safe).
LUMEN_SPEAK_DELAY_S=1.5         # countdown before a sentence is voiced (time to hit Cancel)
LUMEN_QUIET_S=1.5               # a pause this long ends the sentence and sends it to the agent
LUMEN_EXTEND_S=1.5              # one extra wait if the interpreter thinks the signer is not finished
LUMEN_WAIT_FOR_COMPLETE=1       # 1 = let the interpreter ask "are you finished?" before speaking; 0 = speak on the pause (fastest)
LUMEN_LOW_MEAN=0.45             # mean recognition confidence below this asks the signer to sign again
LUMEN_MAX_WAIT_S=10             # hand a sentence over after this long even if signing never pauses
LUMEN_MAX_QUEUE=8               # ... or once this many signs are waiting
LUMEN_CONFIRM_TIMEOUT_S=25      # how long a yes/no read-back waits (no answer counts as No)
LUMEN_DEDUPE_S=2.5              # the same sign again within this window counts as one word
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
# ---- who to alert when the agent is approved to message the emergency contact (docs/NOTIFICATIONS.md) ----
# The FIRST configured transport wins; with none set, notify_contact is an honest DRY RUN (nothing leaves the machine).
EMERGENCY_CONTACT=              # e.g. +14155550123 -- destination for the Twilio backend
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=                    # your Twilio number
TELEGRAM_BOT_TOKEN=             # free: talk to @BotFather, then message your bot once
TELEGRAM_CHAT_ID=               # free: https://api.telegram.org/bot<token>/getUpdates after you message it
NTFY_TOPIC=                     # free push with no account: install the ntfy app and subscribe to this topic
NTFY_SERVER=                    # default https://ntfy.sh
NOTIFY_WEBHOOK_URL=             # or POST JSON {"subject","text"} to any endpoint
NOTIFY_TIMEOUT_S=10
ENABLE_CAPTIONS=                # 1/true/yes/on = laptop mic -> faster-whisper -> captions in the headset; 0/false/empty = off
WHISPER_MODEL=base.en
VAD_RMS=0.015
SIGNBRIDGE_DATA=                # default: ./data (leave empty to use the default)
# ---- Project KAZE (safety timer + duress; see docs/KAZE.md) -----------------------------------------
KAZE_ENABLED=1                  # 0 = do not mount KAZE in the Lumen app
KAZE_DB_URL=                    # empty = sqlite under SIGNBRIDGE_DATA; or postgresql://... (Tiger Data / TimescaleDB)
KAZE_TIMESCALE=1                # 0 = never try to create a TimescaleDB hypertable
KAZE_ADMIN_TOKEN=               # empty = generated into <data>/kaze_admin_token.txt
KAZE_SECRET=                    # empty = generated into <data>/kaze_secret.txt (HMAC key for contact links; keep stable)
KAZE_BASE_URL=                  # default: http://localhost:8000 (must be the public URL for contact links to work)
