# Production environment for the combined Lumen + KAZE server.
# Copy to /etc/lumen/lumen.env, chmod 600, and fill in the values. Never commit this file.
# The app reads this file's keys from the process environment (systemd EnvironmentFile).

# ---- storage -----------------------------------------------------------------
# Where sqlite logs, recordings, progress and generated tokens live (a real disk, backed up).
SIGNBRIDGE_DATA=/var/lib/lumen

# ---- planner / interpreter (optional; offline works with no keys) -------------
LLM_PROVIDER=offline            # anthropic | gemini | offline
NORMALIZER=rule                 # auto | gemini | rule  (rule needs no network)
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-sonnet-5-5
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Every Gemini call goes through a rate-limit gate (server/gemini_gate.py): a burst of signing
# queues instead of stampeding, 429/5xx retry with backoff, and after too many 429s the breaker
# opens and the app runs locally (rule normalizer + offline planner) until the quota recovers.
# GEMINI_MAX_CONCURRENT=1        # serialise Gemini calls (a burst queues behind itself)
# GEMINI_MAX_ATTEMPTS=3          # tries per call: 429, 5xx and hangs
# GEMINI_CALL_BUDGET_S=12        # wall-clock budget shared by those tries
# GEMINI_BACKOFF_S=1.5           # first backoff in seconds; doubles with jitter
# GEMINI_429_TRIP=5              # 429s inside the window that open the breaker
# GEMINI_429_WINDOW_S=30
# GEMINI_COOLDOWN_S=30           # how long to stay local before half-opening
# GEMINI_QUOTA_COOLDOWN_S=300    # ditto when the 429 is a plan-quota exhaustion (gone for the day)

# ---- speech (optional) -------------------------------------------------------
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_multilingual_v2

# ---- SMS / push notifications (optional; dry-run when none set) --------------
# First configured backend wins. See docs/NOTIFICATIONS.md.
# EMERGENCY_CONTACT=+14155550123        # clinic SMS destination
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=
# TELEGRAM_BOT_TOKEN=                    # free: @BotFather
# TELEGRAM_CHAT_ID=
# NTFY_TOPIC=
# NTFY_SERVER=
# NOTIFY_WEBHOOK_URL=

# ---- clinician captions (optional) -------------------------------------------
# ENABLE_CAPTIONS=1
# WHISPER_MODEL=base.en
# VAD_RMS=0.006                         # lower threshold helps capture quieter speakers at a distance

# ---- Project KAZE ------------------------------------------------------------
KAZE_ENABLED=1
KAZE_DEMO_MODE=1                         # one default Quest pairing; disable for multi-person deployments
KAZE_ADMIN_TOKEN=               # generate: python -c 'import secrets;print(secrets.token_urlsafe(32))'
KAZE_SECRET=                    # generate the same way; HMAC key for per-alert contact links
KAZE_BASE_URL=https://DOMAIN    # must match the public URL so contact links work
# KAZE_DB_URL=postgresql://user:pass@host:5432/kaze?sslmode=require   # Tiger Data / TimescaleDB; default: sqlite under SIGNBRIDGE_DATA
# KAZE_TIMESCALE=1             # 0 to skip creating the TimescaleDB hypertable
